	/// P75 das operadoras do ranking com o mesmo porte da escolhida. Reclamações só entre as com 20 mil clientes ou mais; glosa sem os valores improváveis.
	measure 'P75 do porte' =
			VAR _codigo = SELECTEDVALUE ( dIndicador[CODIGO] )
			VAR _porte = SELECTEDVALUE ( dOperadora[PORTE] )
			VAR _grupo =
			    FILTER ( ALL ( dOperadora ), dOperadora[PORTE] = _porte && dOperadora[RANKING_OK] = TRUE () )
			RETURN
			    IF (
			        NOT ISBLANK ( _porte ),
			        SWITCH (
			            _codigo,
			            "sinistralidade", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sinistralidade] ) ), dOperadora[sinistralidade], 0.75 ),
			            "indice_combinado", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[indice_combinado] ) ), dOperadora[indice_combinado], 0.75 ),
			            "margem_liquida", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[margem_liquida] ) ), dOperadora[margem_liquida], 0.75 ),
			            "indice_desp_adm", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[indice_desp_adm] ) ), dOperadora[indice_desp_adm], 0.75 ),
			            "receita_vida_mes", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[receita_vida_mes] ) ), dOperadora[receita_vida_mes], 0.75 ),
			            "custo_vida_mes", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[custo_vida_mes] ) ), dOperadora[custo_vida_mes], 0.75 ),
			            "cresc_vidas_12m", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[cresc_vidas_12m] ) ), dOperadora[cresc_vidas_12m], 0.75 ),
			            "pct_59mais", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_59mais] ) ), dOperadora[pct_59mais], 0.75 ),
			            "igr_12m", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[igr_12m] ) && dOperadora[vidas_mh] >= 20000 ), dOperadora[igr_12m], 0.75 ),
			            "idss", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[idss] ) ), dOperadora[idss], 0.75 ),
			            "glosa_inicial", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[glosa_inicial] ) && NOT dOperadora[flag_glosa] ), dOperadora[glosa_inicial], 0.75 ),
			            "tempo_pagamento_dias", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[tempo_pagamento_dias] ) ), dOperadora[tempo_pagamento_dias], 0.75 ),
			            "sus_falha_por_mil", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sus_falha_por_mil] ) ), dOperadora[sus_falha_por_mil], 0.75 ),
			            "sus_pct_justica", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sus_pct_justica] ) ), dOperadora[sus_pct_justica], 0.75 ),
			            "pct_judicial", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_judicial] ) ), dOperadora[pct_judicial], 0.75 ),
			            "pct_ev_rede_propria", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_ev_rede_propria] ) ), dOperadora[pct_ev_rede_propria], 0.75 )
			        )
