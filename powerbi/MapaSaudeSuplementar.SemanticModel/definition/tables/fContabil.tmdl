/// DIOPS por operadora e trimestre: acumulado no ano (_ytd) e 12 meses (_12m).
table fContabil
	lineageTag: bf6b8106-b385-5b20-948d-5c4edc2629d1

	/// Quanto da mensalidade volta em atendimento. (eventos + |corresponsabilidade cedida|) ÷ (contraprestações efetivas + |corresponsabilidade cedida|), 12 meses. Soma numerador e denominador antes de dividir: é a média ponderada pela receita.
	measure 'Sinistralidade (12 meses)' = DIVIDE ( SUM ( fContabil[sinist_num_12m] ), SUM ( fContabil[sinist_den_12m] ) )
		formatString: 0.0%
		displayFolder: 1. Sinistralidade
		lineageTag: 57eb4b79-c2bc-50e5-99b9-eb04a8edf728

	/// Mesma fórmula, acumulada de janeiro até o trimestre. É o número que a ANS divulga.
	measure 'Sinistralidade (no ano)' = DIVIDE ( SUM ( fContabil[sinist_num_ytd] ), SUM ( fContabil[sinist_den_ytd] ) )
		formatString: 0.0%
		displayFolder: 1. Sinistralidade
		lineageTag: 98798125-faab-52b5-8836-2fde9b82f4a2

	/// (eventos + |CCT| + despesas administrativas + comercialização) ÷ (contraprestações efetivas + |CCT| + receitas administrativas). Acima de 100%, a operação do plano dá prejuízo.
	measure 'Índice combinado (12 meses)' = DIVIDE ( SUM ( fContabil[comb_num_12m] ), SUM ( fContabil[comb_den_12m] ) )
		formatString: 0.0%
		displayFolder: 1. Sinistralidade
		lineageTag: cdddf664-e42c-5819-b95b-3b6868195ec4

	/// Receitas menos despesas da operação de saúde (contas 31+32+33+34+37 − 41−43−44−46). Ano fechado: usa o acumulado do 4º trimestre.
	measure 'Resultado da operação (R$ bi)' = DIVIDE ( CALCULATE ( SUM ( fContabil[resultado_operacional_ytd] ), dTrimestre[FIM_DE_ANO] = TRUE () ), 1E9 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: b0154cad-8e33-5f3d-84ba-3dfdc581a156

	/// Soma dos cinco anos fechados.
	measure 'Resultado da operação 2021–2025 (R$ bi)' = CALCULATE ( [Resultado da operação (R$ bi)], dTrimestre[ANO] >= 2021, dTrimestre[ANO] <= 2025 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: 3b02ba0b-7822-5836-997c-930dfc6fac16

	/// Receitas menos despesas financeiras (contas 35 − 45). Ano fechado: usa o acumulado do 4º trimestre.
	measure 'Resultado das aplicações (R$ bi)' = DIVIDE ( CALCULATE ( SUM ( fContabil[resultado_financeiro_ytd] ), dTrimestre[FIM_DE_ANO] = TRUE () ), 1E9 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: cdea3207-d82d-5452-bb7e-68f56f071c0a

	/// Soma dos cinco anos fechados.
	measure 'Resultado das aplicações 2021–2025 (R$ bi)' = CALCULATE ( [Resultado das aplicações (R$ bi)], dTrimestre[ANO] >= 2021, dTrimestre[ANO] <= 2025 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: 923d6752-3cd3-5b58-9976-7764b08d7f4d

	/// Receitas − despesas − impostos e participações (contas 3 − 4 − 61). Ano fechado: usa o acumulado do 4º trimestre.
	measure 'Lucro líquido (R$ bi)' = DIVIDE ( CALCULATE ( SUM ( fContabil[resultado_liquido_ytd] ), dTrimestre[FIM_DE_ANO] = TRUE () ), 1E9 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: f7295b88-6d60-51d5-8adc-5e305589175b

	/// Soma dos cinco anos fechados.
	measure 'Lucro líquido 2021–2025 (R$ bi)' = CALCULATE ( [Lucro líquido (R$ bi)], dTrimestre[ANO] >= 2021, dTrimestre[ANO] <= 2025 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: ed6dd7cd-0e7e-5749-8502-38783ebd4c0e

	measure 'Lucro líquido 12 meses (R$ mi)' = DIVIDE ( SUM ( fContabil[resultado_liquido_12m] ), 1E6 )
		formatString: #,0.0
		displayFolder: 2. Resultado
		lineageTag: 01bdf07e-b290-558e-a02a-74a8dfdacd10

	/// Quantas vezes as aplicações renderam o que a operação rendeu.
	measure 'Aplicações ÷ operação (ano)' = DIVIDE ( [Resultado das aplicações (R$ bi)], [Resultado da operação (R$ bi)] )
		formatString: 0.0x
		displayFolder: 2. Resultado
		lineageTag: 69d4774d-4064-5ff3-a0e2-ab667440884c

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos por procedimento' = DIVIDE ( SUM ( fContabil[ev_procedimento_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: 147e9106-6467-593e-9bdf-3ce0d7a126be

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos em pacote' = DIVIDE ( SUM ( fContabil[ev_pacote_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: e3525d87-f86a-540a-a298-9cf27121b4bc

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos em rede própria' = DIVIDE ( SUM ( fContabil[ev_rede_propria_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: 4f1f8023-3e5c-5f95-83dd-1cf7242ef26f

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos em rede indireta' = DIVIDE ( SUM ( fContabil[ev_rede_indireta_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: e71d3679-760e-5a7a-96d8-388b8466480b

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos por capitation' = DIVIDE ( SUM ( fContabil[ev_capitation_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: b3ab4c84-14c8-5938-a362-6655ef4e39fd

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos por orçamento global' = DIVIDE ( SUM ( fContabil[ev_orcamento_global_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: 6a4f5198-93f8-5e5a-b36f-47c805fb88ce

	/// Eventos conhecidos ou avisados, 12 meses, por forma de pagamento (contas 4111 a 4119).
	measure '% dos eventos por reembolso' = DIVIDE ( SUM ( fContabil[ev_reembolso_12m] ), SUM ( fContabil[ev_conhecidos_12m] ) )
		formatString: 0.0%
		displayFolder: 3. Como paga a rede
		lineageTag: 544fd1fe-1b76-5f19-aba5-3ea04071c177

	/// Despesas judiciais com eventos cobertos (411xxxx7) e não cobertos (4413x9x4) ÷ eventos indenizáveis, 12 meses.
	measure 'Despesa judicial (% dos eventos)' = DIVIDE ( SUM ( fContabil[jud_total_12m] ), SUM ( fContabil[desp_assist_12m] ) )
		formatString: 0.00%
		displayFolder: 3. Como paga a rede
		lineageTag: 4df5cf97-952d-5e91-a0d5-0b05770cf5f0

