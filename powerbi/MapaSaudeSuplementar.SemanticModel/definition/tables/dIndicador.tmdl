/// Tabela desconectada: um indicador por linha, para a ficha da operadora.
table dIndicador
	lineageTag: 4b39bbca-b596-5dec-8663-1e6df2eefc17

	/// Valor do indicador da linha para a operadora escolhida. Glosa improvável (flag) fica em branco.
	measure 'Valor da operadora' =
			VAR _codigo = SELECTEDVALUE ( dIndicador[CODIGO] )
			RETURN
			    IF (
			        HASONEVALUE ( dOperadora[REG] ),
			        SWITCH (
			            _codigo,
			            "sinistralidade", MAX ( dOperadora[sinistralidade] ),
			            "indice_combinado", MAX ( dOperadora[indice_combinado] ),
			            "margem_liquida", MAX ( dOperadora[margem_liquida] ),
			            "indice_desp_adm", MAX ( dOperadora[indice_desp_adm] ),
			            "receita_vida_mes", MAX ( dOperadora[receita_vida_mes] ),
			            "custo_vida_mes", MAX ( dOperadora[custo_vida_mes] ),
			            "cresc_vidas_12m", MAX ( dOperadora[cresc_vidas_12m] ),
			            "pct_59mais", MAX ( dOperadora[pct_59mais] ),
			            "igr_12m", MAX ( dOperadora[igr_12m] ),
			            "idss", MAX ( dOperadora[idss] ),
			            "tempo_pagamento_dias", MAX ( dOperadora[tempo_pagamento_dias] ),
			            "sus_falha_por_mil", MAX ( dOperadora[sus_falha_por_mil] ),
			            "sus_pct_justica", MAX ( dOperadora[sus_pct_justica] ),
			            "pct_judicial", MAX ( dOperadora[pct_judicial] ),
			            "pct_ev_rede_propria", MAX ( dOperadora[pct_ev_rede_propria] ),
			            "glosa_inicial", IF ( SELECTEDVALUE ( dOperadora[flag_glosa] ), BLANK (), MAX ( dOperadora[glosa_inicial] ) )
			        )
			    )
		displayFolder: 5. Ficha
		lineageTag: c1e6895e-e055-520a-bb49-bb1572bb0fe8

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( dIndicador[FORMATO] ), "pct", "0.0%", "brl", "R$ #,0", "num0", "#,0", "num1", "#,0.0", "num3", "0.000", "#,0.0" )

	/// P25 das operadoras do ranking com o mesmo porte da escolhida. Reclamações só entre as com 20 mil clientes ou mais; glosa sem os valores improváveis.
	measure 'P25 do porte' =
			VAR _codigo = SELECTEDVALUE ( dIndicador[CODIGO] )
			VAR _porte = SELECTEDVALUE ( dOperadora[PORTE] )
			VAR _grupo =
			    FILTER ( ALL ( dOperadora ), dOperadora[PORTE] = _porte && dOperadora[RANKING_OK] = TRUE () )
			RETURN
			    IF (
			        NOT ISBLANK ( _porte ),
			        SWITCH (
			            _codigo,
			            "sinistralidade", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sinistralidade] ) ), dOperadora[sinistralidade], 0.25 ),
			            "indice_combinado", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[indice_combinado] ) ), dOperadora[indice_combinado], 0.25 ),
			            "margem_liquida", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[margem_liquida] ) ), dOperadora[margem_liquida], 0.25 ),
			            "indice_desp_adm", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[indice_desp_adm] ) ), dOperadora[indice_desp_adm], 0.25 ),
			            "receita_vida_mes", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[receita_vida_mes] ) ), dOperadora[receita_vida_mes], 0.25 ),
			            "custo_vida_mes", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[custo_vida_mes] ) ), dOperadora[custo_vida_mes], 0.25 ),
			            "cresc_vidas_12m", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[cresc_vidas_12m] ) ), dOperadora[cresc_vidas_12m], 0.25 ),
			            "pct_59mais", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_59mais] ) ), dOperadora[pct_59mais], 0.25 ),
			            "igr_12m", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[igr_12m] ) && dOperadora[vidas_mh] >= 20000 ), dOperadora[igr_12m], 0.25 ),
			            "idss", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[idss] ) ), dOperadora[idss], 0.25 ),
			            "glosa_inicial", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[glosa_inicial] ) && NOT dOperadora[flag_glosa] ), dOperadora[glosa_inicial], 0.25 ),
			            "tempo_pagamento_dias", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[tempo_pagamento_dias] ) ), dOperadora[tempo_pagamento_dias], 0.25 ),
			            "sus_falha_por_mil", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sus_falha_por_mil] ) ), dOperadora[sus_falha_por_mil], 0.25 ),
			            "sus_pct_justica", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sus_pct_justica] ) ), dOperadora[sus_pct_justica], 0.25 ),
			            "pct_judicial", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_judicial] ) ), dOperadora[pct_judicial], 0.25 ),
			            "pct_ev_rede_propria", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_ev_rede_propria] ) ), dOperadora[pct_ev_rede_propria], 0.25 )
			        )
			    )
		displayFolder: 5. Ficha
		lineageTag: 5f862d01-2121-5146-9c27-72f8dbc3f382

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( dIndicador[FORMATO] ), "pct", "0.0%", "brl", "R$ #,0", "num0", "#,0", "num1", "#,0.0", "num3", "0.000", "#,0.0" )

	/// Mediana das operadoras do ranking com o mesmo porte da escolhida. Reclamações só entre as com 20 mil clientes ou mais; glosa sem os valores improváveis.
	measure 'Mediana do porte' =
			VAR _codigo = SELECTEDVALUE ( dIndicador[CODIGO] )
			VAR _porte = SELECTEDVALUE ( dOperadora[PORTE] )
			VAR _grupo =
			    FILTER ( ALL ( dOperadora ), dOperadora[PORTE] = _porte && dOperadora[RANKING_OK] = TRUE () )
			RETURN
			    IF (
			        NOT ISBLANK ( _porte ),
			        SWITCH (
			            _codigo,
			            "sinistralidade", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sinistralidade] ) ), dOperadora[sinistralidade], 0.5 ),
			            "indice_combinado", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[indice_combinado] ) ), dOperadora[indice_combinado], 0.5 ),
			            "margem_liquida", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[margem_liquida] ) ), dOperadora[margem_liquida], 0.5 ),
			            "indice_desp_adm", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[indice_desp_adm] ) ), dOperadora[indice_desp_adm], 0.5 ),
			            "receita_vida_mes", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[receita_vida_mes] ) ), dOperadora[receita_vida_mes], 0.5 ),
			            "custo_vida_mes", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[custo_vida_mes] ) ), dOperadora[custo_vida_mes], 0.5 ),
			            "cresc_vidas_12m", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[cresc_vidas_12m] ) ), dOperadora[cresc_vidas_12m], 0.5 ),
			            "pct_59mais", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_59mais] ) ), dOperadora[pct_59mais], 0.5 ),
			            "igr_12m", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[igr_12m] ) && dOperadora[vidas_mh] >= 20000 ), dOperadora[igr_12m], 0.5 ),
			            "idss", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[idss] ) ), dOperadora[idss], 0.5 ),
			            "glosa_inicial", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[glosa_inicial] ) && NOT dOperadora[flag_glosa] ), dOperadora[glosa_inicial], 0.5 ),
			            "tempo_pagamento_dias", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[tempo_pagamento_dias] ) ), dOperadora[tempo_pagamento_dias], 0.5 ),
			            "sus_falha_por_mil", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sus_falha_por_mil] ) ), dOperadora[sus_falha_por_mil], 0.5 ),
			            "sus_pct_justica", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[sus_pct_justica] ) ), dOperadora[sus_pct_justica], 0.5 ),
			            "pct_judicial", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_judicial] ) ), dOperadora[pct_judicial], 0.5 ),
			            "pct_ev_rede_propria", PERCENTILEX.INC ( FILTER ( _grupo, NOT ISBLANK ( dOperadora[pct_ev_rede_propria] ) ), dOperadora[pct_ev_rede_propria], 0.5 )
			        )
			    )
		displayFolder: 5. Ficha
		lineageTag: f89d854c-4dbc-572e-8312-70494fe22f13

