/// Operadoras médico-hospitalares: cadastro da ANS e foto atual dos indicadores (ind_operadora).
table dOperadora
	lineageTag: da2da9f8-ad8d-5e02-84ce-e29ebf62e2a4

	/// Ativas, ≥ 1.000 vidas médicas, receita nos últimos 12 meses e sinistralidade entre 30% e 150%.
	measure 'Operadoras no ranking' = CALCULATE ( COUNTROWS ( dOperadora ), dOperadora[RANKING_OK] = TRUE () )
		formatString: #,0
		displayFolder: 4. Operadoras
		lineageTag: 0eb00d9c-a934-5d5b-b3d7-8aaff79031bd

	/// Resultado da operação negativo nos 12 meses até jun/2026. Só operadoras do ranking.
	measure '% com prejuízo na operação' =
			VAR _ranking = FILTER ( dOperadora, dOperadora[RANKING_OK] = TRUE () )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( _ranking, dOperadora[resultado_operacional] < 0 ) ), COUNTROWS ( _ranking ) )
		formatString: 0.0%
		displayFolder: 4. Operadoras
		lineageTag: 042672f8-80b1-58f7-bdad-a491187729c5

	/// Lucro líquido negativo nos 12 meses até jun/2026. Só operadoras do ranking.
	measure '% com prejuízo no fim' =
			VAR _ranking = FILTER ( dOperadora, dOperadora[RANKING_OK] = TRUE () )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( _ranking, dOperadora[resultado_liquido] < 0 ) ), COUNTROWS ( _ranking ) )
		formatString: 0.0%
		displayFolder: 4. Operadoras
		lineageTag: a415aa1b-aaf9-52af-8704-08d05b5feb40

	/// Prejuízo na operação, mas lucro no fim graças ao resultado financeiro. Só operadoras do ranking.
	measure '% salvas pelas aplicações' =
			VAR _ranking = FILTER ( dOperadora, dOperadora[RANKING_OK] = TRUE () )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( _ranking, dOperadora[resultado_operacional] < 0 && dOperadora[resultado_liquido] > 0 ) ), COUNTROWS ( _ranking ) )
		formatString: 0.0%
		displayFolder: 4. Operadoras
		lineageTag: ec7c1497-5406-5456-8771-b1d5a6f63aee

	measure 'Operadora escolhida' = SELECTEDVALUE ( dOperadora[NOME_EXIBICAO], "Escolha uma operadora" )
		displayFolder: 5. Ficha
		lineageTag: 9463ef86-2e7b-5e42-a762-7c7d7a6f9c78

	measure 'Perfil da operadora' =
			IF (
			    HASONEVALUE ( dOperadora[REG] ),
			    SELECTEDVALUE ( dOperadora[MODALIDADE] ) & " · porte " & LOWER ( SELECTEDVALUE ( dOperadora[PORTE] ) )
			        & " · registro ANS " & SELECTEDVALUE ( dOperadora[REG] ) & " · sede " & SELECTEDVALUE ( dOperadora[UF_SEDE] )
			)
		displayFolder: 5. Ficha
		lineageTag: 6cbaa203-ce98-5034-90b5-b809e8dc1c21

	measure 'Aviso de ranking' =
			VAR _motivo = SELECTEDVALUE ( dOperadora[MOTIVO_FORA_RANKING] )
			RETURN
			    IF (
			        HASONEVALUE ( dOperadora[REG] ),
			        IF ( ISBLANK ( _motivo ), "Comparada com as operadoras do mesmo porte.", "Fora do ranking: " & _motivo & ". Os números aparecem, sem comparação." )
			    )
		displayFolder: 5. Ficha
		lineageTag: 6cde30ac-51e7-541f-9a31-8bcf0cf4216b

	/// Mediana, trimestre a trimestre, das operadoras do ranking com o mesmo porte da escolhida (porte atual).
	measure 'Sinistralidade (12 meses) – mediana do porte' =
			VAR _porte = SELECTEDVALUE ( dOperadora[PORTE] )
			RETURN
			    IF (
			        NOT ISBLANK ( _porte ),
			        CALCULATE (
			            MEDIANX (
			                FILTER ( VALUES ( dOperadora[REG] ), [Sinistralidade (12 meses)] >= 0.3 && [Sinistralidade (12 meses)] <= 1.5 ),
			                [Sinistralidade (12 meses)]
			            ),
			            REMOVEFILTERS ( dOperadora ),
			            dOperadora[PORTE] = _porte,
			            dOperadora[RANKING_OK] = TRUE ()
			        )
			    )
		formatString: 0.0%
		displayFolder: 5. Ficha
		lineageTag: 2fb400aa-6bbc-5a38-bb7c-ba49f8987678

