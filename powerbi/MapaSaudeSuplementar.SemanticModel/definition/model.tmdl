model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados", "dOperadora", "dTrimestre", "dCompetencia", "dIndicador", "dFormaPagamento", "fContabil", "fCarteira", "fIGR"]

ref table dOperadora
ref table dTrimestre
ref table dCompetencia
ref table dIndicador
ref table dFormaPagamento
ref table fContabil
ref table fCarteira
ref table fIGR
